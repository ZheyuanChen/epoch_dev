# T-BMT test 1: velocity perpendicular to a uniform B (gyration).
# B = b0 z, u = u0 x, E = 0. Only the (a + 1/gamma) B term survives, so S
# precesses about z at Omega = (q/m)(a + 1/gamma) b0, i.e. the in-plane
# spin angle is linear in time and the in-plane spin reverses after
# pi/|Omega|. A spin anti-parallel to B lies on the precession axis and
# must not move.
begin:constant
  # Cell size sets dt (CFL); run_tests.sh rescales it for the dt scan
  cell = 0.2 * micron
  # Electron anomalous moment alpha/(2 pi)
  a_e = 1.1614097e-3
  # Initial momentum |u| = |p|/(m c) = 2 sqrt(2), i.e. gamma = 3
  u0 = 2 * sqrt(2)
  b0 = 100.0
  e0 = 1.0e10
end:constant

begin:control
  nx = 16
  ny = 16
  x_min = 0
  x_max = 16 * cell
  y_min = 0
  y_max = 16 * cell
  t_end = 1.1 * pico
  stdout_frequency = 1000
end:control

begin:boundaries
  bc_x_min = periodic
  bc_x_max = periodic
  bc_y_min = periodic
  bc_y_max = periodic
end:boundaries

begin:fields
  bz = b0
end:fields

begin:species
  name = transverse
  identify:electron
  anomalous_magnetic_moment = a_e
  nparticles = 4
  number_density = 1.0
  temperature = 0
  drift_x = u0 * me * c
  drift_y = 0
  drift_z = 0
  spin = directed
  spin_x = 1
  spin_y = 0
  spin_z = 0
end:species

begin:species
  name = antiparallel
  identify:electron
  anomalous_magnetic_moment = a_e
  nparticles = 4
  number_density = 1.0
  temperature = 0
  drift_x = u0 * me * c
  drift_y = 0
  drift_z = 0
  spin = directed
  spin_x = 0
  spin_y = 0
  spin_z = -1
end:species

begin:output
  dt_snapshot = 10 * femto
  particles = always
  px = always
  py = always
  pz = always
  spin_x = always
  spin_y = always
  spin_z = always
  ex = always
  ey = always
  ez = always
  bx = always
  by = always
  bz = always
end:output
