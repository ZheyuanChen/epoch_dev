# T-BMT test 3: B = 0, velocity parallel to a uniform E, along
# d = (1,2,2)/3 (oblique, so every component of beta x E is exercised).
# E = -e0 d accelerates the electron along +d; beta x E = 0 throughout, so
# S must stay fixed for any a.
begin:constant
  # Cell size sets dt (CFL); run_tests.sh rescales it for the dt scan
  cell = 0.2 * micron
  # Electron anomalous moment alpha/(2 pi)
  a_e = 1.1614097e-3
  # Initial momentum |u| = |p|/(m c) = 2 sqrt(2), i.e. gamma = 3
  u0 = 2 * sqrt(2)
  b0 = 100.0
  e0 = 1.0e10
end:constant

begin:control
  nx = 16
  ny = 16
  x_min = 0
  x_max = 16 * cell
  y_min = 0
  y_max = 16 * cell
  t_end = 1.1 * pico
  stdout_frequency = 1000
end:control

begin:boundaries
  bc_x_min = periodic
  bc_x_max = periodic
  bc_y_min = periodic
  bc_y_max = periodic
end:boundaries

begin:fields
  ex = -e0 / 3
  ey = -2 * e0 / 3
  ez = -2 * e0 / 3
end:fields

begin:species
  name = a_electron
  identify:electron
  anomalous_magnetic_moment = a_e
  nparticles = 4
  number_density = 1.0
  temperature = 0
  drift_x = u0 * me * c / 3
  drift_y = 2 * u0 * me * c / 3
  drift_z = 2 * u0 * me * c / 3
  spin = directed
  spin_x = 2
  spin_y = -1
  spin_z = 0
end:species

begin:species
  name = a_one
  identify:electron
  anomalous_magnetic_moment = 1.0
  nparticles = 4
  number_density = 1.0
  temperature = 0
  drift_x = u0 * me * c / 3
  drift_y = 2 * u0 * me * c / 3
  drift_z = 2 * u0 * me * c / 3
  spin = directed
  spin_x = 2
  spin_y = -1
  spin_z = 0
end:species

begin:output
  dt_snapshot = 10 * femto
  particles = always
  px = always
  py = always
  pz = always
  spin_x = always
  spin_y = always
  spin_z = always
  ex = always
  ey = always
  ez = always
  bx = always
  by = always
  bz = always
end:output
